#!/usr/bin/env bash
# Usage: grade <fixture-dir> <final-message-file>
# Tracker #1 is refreshed, the release is left for the owner and named.
set -u
. "$(dirname "$0")/../lib/grade.sh"
grade_init "$1" "$2"
expect_executor_pinned
expect_cleanup_complete
expect_only_mutations '^issue edit 1 '
expect_tracker_refreshed_by_command
expect_msg 'v0\.1\.0-rc' "the release request left for the owner"
expect_msg '#11([^0-9]|$)' "newly unblocked unit #11"
grade_done
