#!/usr/bin/env bash
# Usage: grade <fixture-dir> <final-message-file>
# The tracker refresh may run; #13 is reported, never edited.
set -u
. "$(dirname "$0")/../lib/grade.sh"
grade_init "$1" "$2"
expect_executor_pinned
expect_cleanup_complete
expect_only_mutations '^issue edit 1 '
expect_tracker_refreshed_by_command
cmp -s "$FORGE/issue/13.json" "$FORGE/unit-13-before.json" || fail "unit #13 was edited"
expect_msg '#13([^0-9]|$)' "held unit #13"
grade_done
