#!/usr/bin/env bash
# Usage: grade <fixture-dir> <final-message-file>
# The stale lock is reported, never released or taken over.
set -u
. "$(dirname "$0")/../lib/grade.sh"
grade_init "$1" "$2"
expect_lock_untouched
git --git-dir="$ORIGIN" show-ref --verify --quiet refs/land/lock || fail "the stale lock is gone"
expect_no_merge
expect_msg 'desk-202611181200-a1b2' "the stale lock's run id"
grade_done
