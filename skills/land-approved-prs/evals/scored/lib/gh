#!/usr/bin/env bash
# Fixture forge for the scored land-approved-prs eval: a stand-in for the
# GitHub CLI that serves one repository from files and from the origin's
# git state, and logs every call. Response shapes follow the shims in
# scripts/test-list-ready.sh, scripts/test-land.sh, and
# scripts/test-landed-since.sh, widened so an agent's own lookups work too.
#
# The forge directory sits next to this file's directory (<fixture>/forge):
#   host, slug         The only repository that exists (github.invalid,
#                      acme/repo). A hostless OWNER/NAME resolves through
#                      GH_HOST, as gh does; unset, it means github.com,
#                      where the runner's dummy token is rejected.
#   origin             The bare repository that plays the forge's git.
#   repo.json          REST repository facts.
#   pr/<N>.json        Stored PR facts. An open PR's head is read live from
#                      the origin's branch, so a push shows at once.
#   timeline/<N>.json  Label events. Force-pushes come from the ref log.
#   comments/<N>.json  Issue comments, including ones the agent posts.
#   collab/<login>.json  Collaborator permission answers.
#   ci/<oid>           A CI conclusion other than success for that commit;
#                      ci/<oid>.log is its failed-step log, and
#                      ci/<oid>.attempt its run attempt after a rerun.
#   ref-updates.log    Written by the origin's hook; see fixture.sh.
#   calls.log          One line per call: the arguments joined by spaces.
#   mutations.log      One line per forge write the stub applied, in order:
#                      "<time> comment <N>", "<time> label+ <N> <name>",
#                      "<time> label- <N> <name>", "<time> merge <N> <oid>",
#                      "<time> rerun <run-id>", and so on.
#
# Every CI run is one GitHub Actions job named "test", green unless ci/<oid>
# says otherwise. Merging makes a real merge commit in the origin, deletes
# the head branch (the repository auto-deletes), and retargets open PRs
# based on it, as GitHub does. Anything else fails the way gh does.
set -u
FORGE=$(cd "$(dirname "$0")/../forge" && pwd) || exit 1
# One line per call, so a multi-line argument (a GraphQL query) can't fake one.
{ printf '%s' "$*" | tr '\n' ' '; echo; } >>"$FORGE/calls.log"
HOST=$(cat "$FORGE/host")
SLUG=$(cat "$FORGE/slug")
ORIGIN=$(cat "$FORGE/origin")
Z40=0000000000000000000000000000000000000000
ME=fixture-bot

og() { git --git-dir="$ORIGIN" "$@"; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
die() { printf '%s\n' "$1" >&2; exit "${2:-1}"; }
record() { printf '%s %s\n' "$(now)" "$*" >>"$FORGE/mutations.log"; }
TMPS=()
tmpf() { local t; t=$(mktemp); TMPS+=("$t"); printf '%s' "$t"; }
trap 'rm -f "${TMPS[@]+"${TMPS[@]}"}"' EXIT

# --- arguments ----------------------------------------------------------------
sub="${1:-}"
[ $# -eq 0 ] || shift
verb=""
case "$sub" in
  api|""|--version|version) ;;
  *) verb="${1:-}"; [ $# -eq 0 ] || shift ;;
esac
repo="" hostname="" json="" jqf="" body="" bodyset=false bodyfile="" method=""
inputf="" match="" subject="" mmethod="" job="" state="" headf="" basef=""
labelf="" branchf="" commitf="" logfailed=false logall=false nameonly=false
showcomments=false slurp=false
fields=() addl=() reml=() pos=()
while [ $# -gt 0 ]; do
  a="$1"; shift
  case "$a" in
    --*=*) set -- "${a%%=*}" "${a#*=}" "$@"; continue ;;
  esac
  case "$a" in
    --repo|-R) repo="${1:-}"; shift ;;
    --hostname) hostname="${1:-}"; shift ;;
    --json) json="${1:-}"; shift ;;
    --jq|-q) jqf="${1:-}"; shift ;;
    --body) body="${1:-}"; bodyset=true; shift ;;
    -b) if [ "$sub" = run ]; then branchf="${1:-}"; else body="${1:-}"; bodyset=true; fi; shift ;;
    --body-file) bodyfile="${1:-}"; shift ;;
    -F) if [ "$sub" = api ]; then fields+=("${1:-}"); else bodyfile="${1:-}"; fi; shift ;;
    -f|--field|--raw-field) fields+=("${1:-}"); shift ;;
    --input) inputf="${1:-}"; shift ;;
    -X|--method) method=$(printf '%s' "${1:-}" | tr a-z A-Z); shift ;;
    -H) if [ "$sub" = api ]; then shift; else headf="${1:-}"; shift; fi ;;
    --head) headf="${1:-}"; shift ;;
    --header|--template|--cache|--preview|-p|--title|--limit|-L|--author|-A|--assignee|-a|--search|-S|--workflow|-w|--event|-e|--user|-u|--status|--attempt|--milestone|--project|--reviewer|--add-reviewer|--add-assignee|--author-email|--color|-c|--description|-d)
      case "$a" in
        -c) if [ "$sub" = run ]; then commitf="${1:-}"; fi ;;
        -d) if [ "$verb" = merge ]; then set -- "${1:-}" "$@"; fi ;;
      esac
      shift ;;
    --add-label) addl+=("${1:-}"); shift ;;
    --remove-label) reml+=("${1:-}"); shift ;;
    --match-head-commit) match="${1:-}"; shift ;;
    --subject|-t) subject="${1:-}"; shift ;;
    --merge|-m) mmethod=merge ;;
    --squash) mmethod=squash ;;
    --rebase|-r) mmethod=rebase ;;
    --state|-s) if [ "$verb" = merge ]; then mmethod=squash; else state="${1:-}"; shift; fi ;;
    --base|-B) basef="${1:-}"; shift ;;
    --label|-l) labelf="${1:-}"; shift ;;
    --branch) branchf="${1:-}"; shift ;;
    --commit) commitf="${1:-}"; shift ;;
    --job|-j) job="${1:-}"; shift ;;
    --log-failed) logfailed=true ;;
    --log) logall=true ;;
    --name-only) nameonly=true ;;
    --comments) showcomments=true ;;
    --slurp) slurp=true ;;
    --paginate|--failed|--include|-i|--silent|--verbose|-v|--yes|-y|--delete-branch|--auto|--admin|--patch|--exit-status|--watch|--web|-W|--draft|--fill|--no-color) ;;
    -*) die "unknown flag: $a
Usage: gh $sub $verb [flags]" ;;
    *) pos+=("$a") ;;
  esac
done
P0="${pos[0]:-}"
case "$P0" in
  https://*/pull/[0-9]*|https://*/issues/[0-9]*)
    u="${P0#https://}"; repo="${u%%/pull/*}"; repo="${repo%%/issues/*}"; P0="${u##*/}" ;;
esac

# --- host and repository identity ---------------------------------------------
check_host() {
  case "$1" in
    "$HOST") ;;
    github.com) die "HTTP 401: Bad credentials (https://api.github.com/graphql)
Try authenticating with:  gh auth login" ;;
    *) die "error connecting to $1
check your internet connection or https://githubstatus.com" ;;
  esac
}
resolve_repo() {
  local spec="${repo:-${GH_REPO:-}}" h s
  case "$spec" in
    "") die "none of the git remotes configured for this repository point to a known GitHub host. To tell gh about a new GitHub host, please use \`gh auth login\`" ;;
    https://*) spec="${spec#https://}"; spec="${spec%.git}" ;;
  esac
  case "$spec" in
    */*/*) h="${spec%%/*}"; s="${spec#*/}" ;;
    */*) h="${GH_HOST:-github.com}"; s="$spec" ;;
    *) die "expected the \"[HOST/]OWNER/REPO\" format, got \"$spec\"" ;;
  esac
  check_host "$h"
  [ "$s" = "$SLUG" ] \
    || die "GraphQL: Could not resolve to a Repository with the name '$s'. (repository)"
}

# --- output -------------------------------------------------------------------
# Project to the requested --json fields (missing ones are null), then apply
# --jq, as gh does.
emit() { # emit <json-file>
  local filter="."
  [ -z "$json" ] || filter="{$(printf '%s' "$json" | tr -d ' ')}"
  if [ -n "$jqf" ]; then
    if [ "$slurp" = true ]; then jq -s "$filter" "$1" | jq -r "$jqf"; else jq "$filter" "$1" | jq -r "$jqf"; fi
  elif [ "$slurp" = true ]; then jq -s "$filter" "$1"
  else jq "$filter" "$1"; fi
}
emit_list() { # emit_list <json-array-file>
  [ -z "$json" ] || { jq "[.[] | {$(printf '%s' "$json" | tr -d ' ')}]" "$1" >"$1.p" && mv "$1.p" "$1"; }
  if [ -n "$jqf" ]; then jq -r "$jqf" "$1"; else jq . "$1"; fi
}

# --- CI -------------------------------------------------------------------------
runid() { printf '%d' "0x${1:0:7}"; }
ci_concl() { cat "$FORGE/ci/$1" 2>/dev/null || echo success; }
ci_attempt() { cat "$FORGE/ci/$1.attempt" 2>/dev/null || echo 1; }
jobid() { echo $(( $(runid "$1") * 10 + $(ci_attempt "$1") )); }
run_url() { printf 'https://%s/%s/actions/runs/%s' "$HOST" "$SLUG" "$(runid "$1")"; }
# all_runs: one pull_request run per pushed head of a branch other than main.
all_runs() {
  local t ref old new forced actor
  while read -r t ref old new forced actor; do
    case "$ref" in refs/heads/main|refs/land/*) continue ;; esac
    [ "$new" != "$Z40" ] || continue
    jq -n --argjson id "$(runid "$new")" --arg sha "$new" --arg b "${ref#refs/heads/}" \
      --arg t "$t" --arg c "$(ci_concl "$new")" --argjson at "$(ci_attempt "$new")" \
      --arg url "$(run_url "$new")" --arg slug "$SLUG" \
      '{id:$id, name:"CI", workflow_id:1, event:"pull_request", status:"completed",
        conclusion:$c, run_attempt:$at, head_sha:$sha, head_branch:$b,
        created_at:$t, updated_at:$t, html_url:$url, url:$url,
        head_repository:{full_name:$slug}}'
  done <"$FORGE/ref-updates.log" | jq -s 'unique_by(.id) | sort_by(.created_at) | reverse'
}
run_oid() { # run_oid <run-id>: the head a run belongs to
  all_runs | jq -r --argjson id "$1" '.[] | select(.id == $id) | .head_sha' | head -n 1
}
check_runs() { # check_runs <oid>
  jq -n --argjson id "$(jobid "$1")" --arg c "$(ci_concl "$1")" --arg sha "$1" \
    --arg url "$(run_url "$1")/job/$(jobid "$1")" \
    '{total_count:1, check_runs:[{id:$id, name:"test", status:"completed", conclusion:$c,
      head_sha:$sha, app:{slug:"github-actions"}, details_url:$url, html_url:$url}]}'
}

# --- PRs --------------------------------------------------------------------------
pr_file() {
  case "${1:-x}" in *[!0-9]*) die "GraphQL: Could not resolve to a PullRequest with the number of ${1:-?}. (repository.pullRequest)" ;; esac
  [ -f "$FORGE/pr/$1.json" ] \
    || die "GraphQL: Could not resolve to a PullRequest with the number of $1. (repository.pullRequest)"
  printf '%s' "$FORGE/pr/$1.json"
}
pr_head() { # pr_head <N>: live while open, stored otherwise
  local f="$FORGE/pr/$1.json"
  if [ "$(jq -r .state "$f")" = OPEN ]; then
    og rev-parse --verify --quiet "refs/heads/$(jq -r .headRefName "$f")^{commit}" \
      || jq -r '.headRefOid // empty' "$f"
  else
    jq -r '.headRefOid // empty' "$f"
  fi
}
pr_from() { # pr_from <N> <head>: the commit the PR's diff starts from
  local f="$FORGE/pr/$1.json" tip
  if [ "$(jq -r .state "$f")" = MERGED ]; then
    tip=$(og rev-parse --verify --quiet "$(jq -r .mergeCommit.oid "$f")^1") || return 1
  else
    tip=$(og rev-parse --verify --quiet "refs/heads/$(jq -r .baseRefName "$f")") || return 1
  fi
  og merge-base "$tip" "$2"
}
pr_full() { # pr_full <N> <out-file>: the PR in gh's --json shape
  local n="$1" f head from commits='[]' files='[]' mergeable=UNKNOWN tip rollup='[]'
  f=$(pr_file "$n") || exit 1
  head=$(pr_head "$n")
  if [ -n "$head" ] && from=$(pr_from "$n" "$head"); then
    commits=$(og log --reverse --format='%H%x09%s' "$from..$head" \
      | jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | {oid:.[0], messageHeadline:.[1]})')
    files=$(og diff --numstat "$from" "$head" \
      | jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | {path:.[2], additions:(.[0] | tonumber? // 0), deletions:(.[1] | tonumber? // 0)})')
    rollup=$(jq -n --arg c "$(ci_concl "$head")" --arg url "$(run_url "$head")/job/$(jobid "$head")" \
      '[{__typename:"CheckRun", name:"test", status:"COMPLETED", conclusion:($c | ascii_upcase), detailsUrl:$url}]')
    if tip=$(og rev-parse --verify --quiet "refs/heads/$(jq -r .baseRefName "$f")"); then
      if og merge-tree --write-tree "$tip" "$head" >/dev/null 2>&1; then mergeable=MERGEABLE; else mergeable=CONFLICTING; fi
    fi
  fi
  jq --arg h "$head" --argjson c "$commits" --argjson fl "$files" --argjson r "$rollup" \
    --arg m "$mergeable" --slurpfile cm "$FORGE/comments/$n.json" \
    '.headRefOid = (if $h == "" then .headRefOid else $h end) | .commits = $c | .files = $fl
     | .changedFiles = ($fl | length) | .statusCheckRollup = $r | .mergeable = $m
     | .reviewDecision = "" | .reviews = [] | .reviewRequests = []
     | .comments = ($cm[0] | map({author:{login:.user.login}, body, createdAt:.created_at}))' \
    "$f" >"$2"
}
pr_rest() { # pr_rest <full-pr-file>: the REST pulls shape
  jq --arg slug "$SLUG" '{number, title, body, html_url:.url, url,
    state:(if .state == "OPEN" then "open" else "closed" end), draft:.isDraft,
    merged:(.state == "MERGED"), merged_at:.mergedAt, merge_commit_sha:(.mergeCommit.oid // null),
    commits:(.commits | length), changed_files:.changedFiles, labels,
    user:{login:.author.login}, created_at:.createdAt,
    head:{ref:.headRefName, sha:.headRefOid, repo:{full_name:$slug}},
    base:{ref:.baseRefName, repo:{full_name:$slug}}}' "$1"
}
pr_human() { # pr_human <full-pr-file>
  jq -r '"title:\t\(.title)\nstate:\t\(.state)\nauthor:\t\(.author.login)\nlabels:\t\([.labels[].name] | join(", "))\nnumber:\t\(.number)\nurl:\t\(.url)\nbase:\t\(.baseRefName)\nhead:\t\(.headRefName) \(.headRefOid)\n--\n\(.body // "")"' "$1"
  [ "$showcomments" = false ] \
    || jq -r '.comments[] | "--\nauthor:\t\(.author.login)\n\(.body)"' "$1"
}
set_pr() { # set_pr <N> <jq-update> [jq args...]
  local f="$FORGE/pr/$1.json" u="$2"; shift 2
  jq "$@" "$u" "$f" >"$f.new" && mv "$f.new" "$f"
}
timeline_add() { # timeline_add <N> <event> <label>
  local f="$FORGE/timeline/$1.json"
  jq --arg e "$2" --arg l "$3" --arg at "$(now)" --arg me "$ME" \
    '. + [{event:$e, created_at:$at, label:{name:$l}, actor:{login:$me}}]' "$f" >"$f.new" \
    && mv "$f.new" "$f"
}
label_add() { # label_add <N> <name>
  record "label+ $1 $2"
  jq -e --arg l "$2" 'any(.labels[]; .name == $l)' "$FORGE/pr/$1.json" >/dev/null && return 0
  set_pr "$1" '.labels += [{name:$l}]' --arg l "$2"
  timeline_add "$1" labeled "$2"
}
label_rm() { # label_rm <N> <name>
  record "label- $1 $2"
  jq -e --arg l "$2" 'any(.labels[]; .name == $l)' "$FORGE/pr/$1.json" >/dev/null || return 0
  set_pr "$1" '.labels |= map(select(.name != $l))' --arg l "$2"
  timeline_add "$1" unlabeled "$2"
}
comment_add() { # comment_add <N> <body>
  local f="$FORGE/comments/$1.json"
  jq --arg b "$2" --arg at "$(now)" --arg me "$ME" --arg url "https://$HOST/$SLUG/pull/$1" \
    '. + [{id:(length + 1000), user:{login:$me, type:"User"}, body:$b, created_at:$at,
           html_url:($url + "#issuecomment-" + ((length + 1000) | tostring))}]' "$f" >"$f.new" \
    && mv "$f.new" "$f"
  record "comment $1"
  echo "https://$HOST/$SLUG/pull/$1#issuecomment-$(jq length "$f")"
}
body_text() { # the --body or --body-file text
  if [ -n "$bodyfile" ]; then
    if [ "$bodyfile" = - ]; then cat; else cat -- "$bodyfile" || die "open $bodyfile: no such file or directory"; fi
  elif [ "$bodyset" = true ]; then printf '%s' "$body"
  else die "must provide --body or --body-file when not running interactively"; fi
}
merge_pr() { # merge_pr <N> <method> <match-oid-or-empty> <subject-or-empty> <body>
  local n="$1" f st head base tip tree msg commit child
  f=$(pr_file "$n") || exit 1
  st=$(jq -r .state "$f")
  [ "$st" = OPEN ] || die "X Pull request $SLUG#$n is not open ($st)"
  case "$2" in
    merge) ;;
    squash) die "GraphQL: Squash merges are not allowed on this repository. (mergePullRequest)" ;;
    rebase) die "GraphQL: Rebase merges are not allowed on this repository. (mergePullRequest)" ;;
    *) die "--merge, --rebase, or --squash required when not running interactively" ;;
  esac
  head=$(pr_head "$n"); base=$(jq -r .baseRefName "$f")
  [ -z "$3" ] || [ "$3" = "$head" ] \
    || die "GraphQL: Head branch was modified. Review and try the merge again. (mergePullRequest)"
  tip=$(og rev-parse --verify --quiet "refs/heads/$base") || die "GraphQL: Base branch $base does not exist. (mergePullRequest)"
  # merge-tree exits 1 on a conflict but still prints a tree; refuse it.
  tree=$(og merge-tree --write-tree "$tip" "$head" 2>/dev/null) \
    || die "GraphQL: Pull Request is not mergeable (mergePullRequest)"
  tree=${tree%%$'\n'*}
  msg="${4:-Merge pull request #$n from $(dirname "$SLUG")/$(jq -r .headRefName "$f")}"
  [ -z "$5" ] || msg="$msg"$'\n\n'"$5"
  commit=$(printf '%s\n' "$msg" | GIT_AUTHOR_NAME=Owner GIT_AUTHOR_EMAIL=owner@example.invalid \
    GIT_COMMITTER_NAME=GitHub GIT_COMMITTER_EMAIL=noreply@example.invalid \
    og commit-tree "$tree" -p "$tip" -p "$head") || die "GraphQL: Something went wrong while executing your query. (mergePullRequest)"
  FIXTURE_ACTOR="$ME" og update-ref "refs/heads/$base" "$commit" "$tip" \
    || die "GraphQL: Base branch was modified. Review and try the merge again. (mergePullRequest)"
  set_pr "$n" '.state = "MERGED" | .mergedAt = $at | .mergeCommit = {oid:$m} | .headRefOid = $h' \
    --arg at "$(now)" --arg m "$commit" --arg h "$head"
  record "merge $n $commit"
  # The repository auto-deletes merged branches, and GitHub retargets the
  # open PRs based on a deleted branch onto its base.
  for child in "$FORGE"/pr/*.json; do
    if [ "$(jq -r '.state + " " + .baseRefName' "$child")" = "OPEN $(jq -r .headRefName "$f")" ]; then
      jq --arg b "$base" '.baseRefName = $b' "$child" >"$child.new" && mv "$child.new" "$child"
      record "retarget $(jq -r .number "$child") $base"
    fi
  done
  FIXTURE_ACTOR="$ME" og update-ref -d "refs/heads/$(jq -r .headRefName "$f")" 2>/dev/null
  echo "✓ Merged pull request $SLUG#$n ($(jq -r .title "$f"))" >&2
}

# --- commands -----------------------------------------------------------------
case "$sub" in
  ""|--version|version) echo "gh version 2.0.0-fixture"; exit 0 ;;
  auth)
    case "$verb" in status|token) ;; *) die "fixture gh: unsupported command: auth $verb" ;; esac
    [ -z "$hostname" ] || check_host "$hostname"
    if [ "$verb" = token ]; then echo "fixture-token-not-a-credential"
    else printf '%s\n  ✓ Logged in to %s account %s (GH_TOKEN)\n' "$HOST" "$HOST" "$ME"; fi
    exit 0 ;;

  pr)
    resolve_repo
    case "$verb" in
      view)
        n="$P0"
        if [ -n "$n" ] && [ "${n#*[!0-9]}" != "$n" ]; then
          n=$(jq -s -r --arg b "$n" '[.[] | select(.headRefName == $b)] | sort_by(.number) | last | .number // empty' "$FORGE"/pr/*.json)
        fi
        [ -n "$n" ] || die "could not determine current branch: not on any branch"
        out=$(tmpf); pr_full "$n" "$out" || exit 1
        if [ -z "$json" ]; then pr_human "$out"; else emit "$out"; fi
        exit 0 ;;
      list)
        out=$(tmpf)
        for f in "$FORGE"/pr/*.json; do pr_full "$(jq -r .number "$f")" "$out.$(basename "$f")"; done
        jq -s --arg st "${state:-open}" --arg h "$headf" --arg b "$basef" --arg l "$labelf" '
          [.[] | select($st == "all"
                   or ($st == "open" and .state == "OPEN")
                   or ($st == "closed" and (.state == "CLOSED" or .state == "MERGED"))
                   or ($st == "merged" and .state == "MERGED"))
               | select($h == "" or .headRefName == $h)
               | select($b == "" or .baseRefName == $b)
               | select($l == "" or any(.labels[]; .name == $l))] | sort_by(.number) | reverse' \
          "$out".*.json >"$out"
        rm -f "$out".*.json
        if [ -n "$json" ] || [ -n "$jqf" ]; then emit_list "$out"
        else jq -r '.[] | "\(.number)\t\(.title)\t\(.headRefName)\t\(.state)"' "$out"; fi
        exit 0 ;;
      diff)
        f=$(pr_file "$P0") || exit 1
        head=$(pr_head "$P0"); from=$(pr_from "$P0" "$head") || die "could not find pull request diff"
        if [ "$nameonly" = true ]; then og diff --name-only "$from" "$head"; else og diff "$from" "$head"; fi
        exit 0 ;;
      checks)
        f=$(pr_file "$P0") || exit 1
        head=$(pr_head "$P0"); c=$(ci_concl "$head")
        case "$c" in success) word=pass ;; *) word=fail ;; esac
        printf 'test\t%s\t1m0s\t%s/job/%s\n' "$word" "$(run_url "$head")" "$(jobid "$head")"
        [ "$word" = pass ] || exit 1
        exit 0 ;;
      comment)
        pr_file "$P0" >/dev/null || exit 1
        comment_add "$P0" "$(body_text)"; exit 0 ;;
      edit)
        pr_file "$P0" >/dev/null || exit 1
        for l in ${addl[@]+"${addl[@]}"}; do
          IFS=, read -r -a ls <<<"$l"; for x in "${ls[@]}"; do label_add "$P0" "$x"; done
        done
        for l in ${reml[@]+"${reml[@]}"}; do
          IFS=, read -r -a ls <<<"$l"; for x in "${ls[@]}"; do label_rm "$P0" "$x"; done
        done
        if [ -n "$bodyfile" ] || [ "$bodyset" = true ]; then
          set_pr "$P0" '.body = $b' --arg b "$(body_text)"; record "edit-body $P0"
        fi
        echo "https://$HOST/$SLUG/pull/$P0"; exit 0 ;;
      merge)
        merge_pr "$P0" "$mmethod" "$match" "$subject" "$body"; exit 0 ;;
      close)
        pr_file "$P0" >/dev/null || exit 1
        set_pr "$P0" '.state = "CLOSED"'; record "close $P0"; exit 0 ;;
      reopen|ready|review|lock|unlock|create)
        record "pr-$verb ${P0:-?}"; exit 0 ;;
      *) die "fixture gh: unsupported command: pr $verb" ;;
    esac ;;

  issue)
    resolve_repo
    case "$verb" in
      list) out=$(tmpf); echo '[]' >"$out"
        if [ -n "$json" ] || [ -n "$jqf" ]; then emit_list "$out"; fi; exit 0 ;;
      view)
        [ -f "$FORGE/pr/$P0.json" ] || die "GraphQL: Could not resolve to an issue or pull request with the number of ${P0:-?}. (repository.issue)"
        out=$(tmpf); pr_full "$P0" "$out"
        if [ -z "$json" ]; then pr_human "$out"; else emit "$out"; fi; exit 0 ;;
      comment)
        [ -f "$FORGE/pr/$P0.json" ] || die "GraphQL: Could not resolve to an issue or pull request with the number of ${P0:-?}. (repository.issue)"
        comment_add "$P0" "$(body_text)"; exit 0 ;;
      edit)
        [ -f "$FORGE/pr/$P0.json" ] || die "GraphQL: Could not resolve to an issue or pull request with the number of ${P0:-?}. (repository.issue)"
        for l in ${addl[@]+"${addl[@]}"}; do IFS=, read -r -a ls <<<"$l"; for x in "${ls[@]}"; do label_add "$P0" "$x"; done; done
