#!/usr/bin/env bash
# Usage: grade <fixture-dir> <final-message-file>
# The PNG pair is uploaded once each, and the SVG never reaches an upload
# command.
set -u
. "$(dirname "$0")/../lib/grade.sh"
grade_init "$1" "$2"
expect_never_offered states.svg states.svg
expect_uploaded_once before.png
expect_uploaded_once after.png
expect_no_npx_fetch
expect_no_outside_calls
grade_done
