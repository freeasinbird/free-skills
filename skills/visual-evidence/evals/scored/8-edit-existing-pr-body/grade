#!/usr/bin/env bash
# Usage: grade <fixture-dir> <final-message-file>
# #12's description keeps its text and gains hosted URLs for each image,
# uploaded once, with no local path left behind.
set -u
. "$(dirname "$0")/../lib/grade.sh"
grade_init "$1" "$2"
expect_no_new_pr 12
expect_body_has 12 "Fixes the cramped card rows" "its original summary"
expect_body_has 12 "Checked the task list in Firefox and Chrome." "its original testing notes"
expect_uploaded_once before.png
expect_uploaded_once after.png
expect_body_order 12 before.png after.png
expect_body_no_local_media 12
expect_no_npx_fetch
expect_no_outside_calls
grade_done
