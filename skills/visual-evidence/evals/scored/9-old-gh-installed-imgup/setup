#!/usr/bin/env bash
# Usage: setup <fixture-dir>
# Case 8's fixture with gh 2.87.0, which has no --attach, and gh-imgup
# installed.
set -euo pipefail
. "$(dirname "$0")/../lib/fixture.sh"
fixture_init "$1"
forge_set gh_version 2.87.0
forge_set gh_date 2026-02-24
install_imgup
fix_branch
open_pr 12
shot before.png
shot after.png
fixture_done
