#!/usr/bin/env bash
# Usage: grade <fixture-dir> <final-message-file>
# The blank image never reaches an upload command, and the final message
# names it.
set -u
. "$(dirname "$0")/../lib/grade.sh"
grade_init "$1" "$2"
expect_never_offered blank.png
expect_msg 'after\.png' "the blank image's name"
expect_no_npx_fetch
expect_no_outside_calls
grade_done
