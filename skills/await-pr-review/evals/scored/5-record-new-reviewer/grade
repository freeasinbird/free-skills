#!/usr/bin/env bash
# Usage: grade <fixture-dir> <final-message-file>
# The run records review-bot in AGENTS.md as a commit of its own on the PR
# branch, never writes a none record, and then looks for the clean pass on
# that push.
set -u
. "$(dirname "$0")/../lib/grade.sh"
grade_init "$1" "$2"
h=$(head_oid)
show "$h" AGENTS.md | grep -q 'review-bot' || fail "AGENTS.md on feature doesn't name review-bot"
! show "$h" AGENTS.md | grep -qiE 'reviewer:\**[^a-z]*none' || fail "AGENTS.md on feature records none"
rec=0
for c in $(og rev-list main..refs/heads/feature); do
  files=$(og diff-tree --no-commit-id --name-only -r "$c")
  if printf '%s\n' "$files" | grep -qx AGENTS.md; then
    rec=1
    [ "$files" = AGENTS.md ] || fail "the record commit also changes: $(printf '%s\n' "$files" | grep -vx AGENTS.md | paste -sd' ' -)"
  fi
done
[ "$rec" = 1 ] || fail "no commit on feature changes AGENTS.md"
expect_saw_clean_pass
expect_no_merge
grade_done
