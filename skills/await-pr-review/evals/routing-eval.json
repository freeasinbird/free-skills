{
  "version": 1,
  "purpose": "Measure whether await-pr-review selects a conductor whenever the four conductor grants hold, derives each grant from observable probe evidence with the documented defaults, and names the exact failed grant otherwise.",
  "scoring": {
    "eligible_case_pass": "The first ownership decision is conductor, its compact brief preserves the durable task contract and user constraints, and no main-owned watcher, CI wait, or feedback handling starts before the spawn.",
    "fallback_case_pass": "The exchange remains main-owned and emits `Conductor skipped: <specific failed grant or allowed exception>.` before starting a watcher.",
    "target": "100% of eligible cases choose conductor; at least 90% across repeated fresh-context model runs before accepting prompt wording."
  },
  "cases": [
    {
      "id": "codex-app-shared-checkout-exclusive",
      "surface": "codex-app",
      "request": "The PR is open. Watch for Codex, handle its feedback, and only wake me for judgment calls.",
      "grants": {
        "write_capable_delegation": true,
        "wait_and_resume": true,
        "completion_notification": true,
        "checkout_isolation": false,
        "checkout_exclusivity": true
      },
      "review_already_in_hand": false,
      "expected_owner": "conductor",
      "initial_context": {
        "control_available": true,
        "mechanism": "fork_turns: \"none\"",
        "expected_mode": "fresh or empty"
      }
    },
    {
      "id": "codex-subagents-listed-routes-to-conductor",
      "surface": "codex-app",
      "request": "The PR is open and Codex is reviewing it. Watch for the review and handle the feedback.",
      "probes": {
        "spawn_tool_listed": true,
        "spawn_tool": "spawn_agent",
        "spawn_write_capable": true,
        "delegation_prohibition": "none",
        "subagent_wait": "shell",
        "same_agent_resume": "unobserved",
        "completion_signal": "blocking_wait",
        "checkout": "shared",
        "main_agent_must_change_checkout": false
      },
      "grants": {
        "write_capable_delegation": true,
        "wait_and_resume": true,
        "completion_notification": true,
        "checkout_isolation": false,
        "checkout_exclusivity": true
      },
      "review_already_in_hand": false,
      "expected_owner": "conductor",
      "expected_first_action": "spawn_conductor",
      "forbidden_skip_reasons": [
        "isolated conductor not available",
        "subagent wait-and-resume continuity is uncertain",
        "the checkout is shared"
      ],
      "initial_context": {
        "control_available": true,
        "mechanism": "fork_turns: \"none\"",
        "expected_mode": "fresh or empty"
      }
    },
    {
      "id": "skill-authorizes-conductor-under-disabled-proactive-delegation",
